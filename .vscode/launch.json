    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Model training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/train.py",
            "args": [
                "--dataset_local", "midwest-vehicle-detection",  // coco-2017, midwest-vehicle-detection
                //"--epochs", "1",
                //"--batch_size", "4",
            ],
        }
    ]
}